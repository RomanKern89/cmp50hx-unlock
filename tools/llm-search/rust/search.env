# /data/search-svc-rust/search.env — LLM search service (Rust) configuration
# Set SEARCH_TOKEN to a long random string to require Bearer auth.
SEARCH_TOKEN=
SEARCH_BIND=127.0.0.1:8099

# Optional self-hosted SearXNG (JSON API must be enabled):
SEARCH_SEARX_URL=

# Optional JS-rendering fallback through Cloudflare Kitesurf (URL leaves the host!):
SEARCH_KITESURF_FALLBACK=0

# Limits
SEARCH_CACHE_MB=64
SEARCH_RATE_PER_MIN=60
SEARCH_MAX_BYTES=2097152
SEARCH_MAX_CHARS=20000
SEARCH_RESPECT_ROBOTS=1
SEARCH_FETCH_TTL=21600
